@{
    ViewData["Title"] = "Earth-1610";
}

<style>
   

    .hero-container {
        position: relative;
        height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        overflow: hidden;
        border: 6px solid #fff;
        box-shadow: 15px 15px 0px #ff0044, -15px -15px 0px #00e5ff;
        background: #000;
        margin-top: 2rem;
    }

    /* Abstract Spider-Verse City Skyline effect */
    .hero-bg {
        position: absolute;
        top: -10%; left: -10%; right: -10%; bottom: -10%;
        background-image: 
            linear-gradient(45deg, rgba(10,10,15,0.7) 30%, rgba(255,0,68,0.4) 50%, rgba(0,229,255,0.4) 70%), url('https://i.pinimg.com/1200x/e8/0e/09/e80e095b7759707f947235e610b52e55.jpg');
        background-size: cover;
        background-position: center;
        opacity: 0.8;
        transform: rotate(2deg) scale(1.1);
        filter: contrast(1.2) saturate(1.5) grayscale(20%);
    }

    .hero-content {
        position: relative;
        z-index: 10;
        padding: 40px 60px;
        background: rgba(15,15,20,0.85);
        border: 4px dashed #00e5ff;
        transform: rotate(-3deg);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        box-shadow: 0 0 30px rgba(255, 0, 68, 0.4);
    }

    .hero-glitch {
        font-family: 'Bangers', cursive;
        font-size: 8rem;
        color: #fff;
        text-transform: uppercase;
        letter-spacing: 8px;
        margin: 0;
        line-height: 1;
        text-shadow: 
            6px 0px 0px rgba(255,0,68,1), 
            -6px 0px 0px rgba(0,240,255,1);
        animation: glitch-anim 3s infinite linear alternate-reverse;
    }

    .hero-subtitle {
        font-family: 'Teko', sans-serif;
        font-size: 2.8rem;
        color: #e0e0e0;
        margin-top: 15px;
        letter-spacing: 4px;
        text-shadow: 3px 3px 0px #000;
        border-top: 2px solid #ff0044;
        border-bottom: 2px solid #ff0044;
        padding: 5px 0;
    }

    .enter-btn {
        display: inline-block;
        margin-top: 40px;
        font-family: 'Bangers', cursive;
        font-size: 2.5rem;
        color: #111;
        background: #00e5ff;
        padding: 15px 50px;
        text-decoration: none;
        border: 4px solid #fff;
        box-shadow: 8px 8px 0px #ff0044;
        transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        transform: rotate(3deg);
        letter-spacing: 2px;
    }

    .enter-btn:hover {
        transform: scale(1.1) rotate(0deg);
        background: #ff0044;
        color: #fff;
        box-shadow: -10px 10px 0px #00e5ff;
        border-color: #00e5ff;
    }

    /* Floating Panels Section */
    .comic-panel-container {
        display: flex;
        gap: 30px;
        margin-top: 60px;
        margin-bottom: 60px;
        flex-wrap: wrap;
    }

    .comic-panel {
        flex: 1;
        min-width: 300px;
        background: #15151c;
        border: 4px solid #fff;
        padding: 30px;
        position: relative;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .panel-1 { box-shadow: 10px 10px 0px #ff0044; transform: rotate(1deg); }
    .panel-2 { box-shadow: 10px 10px 0px #bf00ff; transform: rotate(-2deg); }
    .panel-3 { box-shadow: 10px 10px 0px #00e5ff; transform: rotate(1deg); }

    .comic-panel:hover {
        transform: scale(1.05) translateY(-15px);
        z-index: 10;
        background: #000;
    }

    .comic-panel:hover.panel-1 { box-shadow: -10px 10px 0px #ff0044; border-color: #ff0044; }
    .comic-panel:hover.panel-2 { box-shadow: -10px 10px 0px #bf00ff; border-color: #bf00ff; }
    .comic-panel:hover.panel-3 { box-shadow: -10px 10px 0px #00e5ff; border-color: #00e5ff; }

    .panel-title {
        font-family: 'Bangers', cursive;
        font-size: 3rem;
        color: #fff;
        margin-bottom: 15px;
        letter-spacing: 2px;
    }

    .panel-1 .panel-title { text-shadow: 3px 3px 0 #ff0044; }
    .panel-2 .panel-title { text-shadow: 3px 3px 0 #bf00ff; }
    .panel-3 .panel-title { text-shadow: 3px 3px 0 #00e5ff; }

    .panel-text {
        font-family: 'Teko', sans-serif;
        font-size: 1.6rem;
        color: #d0d0d0;
        line-height: 1.3;
        letter-spacing: 1px;
    }
    /* Gallery Section */
    .gallery-title {
        font-family: 'Bangers', cursive;
        font-size: 4rem;
        color: #fff;
        text-align: center;
        letter-spacing: 5px;
        text-shadow: -3px 3px 0 #00e5ff, 3px -3px 0 #ff0044;
        margin-top: 2rem;
        margin-bottom: 2rem;
    }

    .spider-gallery {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 25px;
        margin-bottom: 60px;
    }

    .gallery-item {
        position: relative;
        overflow: hidden;
        border: 4px solid #fff;
        aspect-ratio: 2/3;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 10px 10px 0px rgba(0,0,0,0.6);
        background: #111;
    }
    
    .gallery-item:nth-child(even) {
        transform: translateY(20px);
    }
    
    .gallery-item:hover {
        transform: scale(1.05) rotate(-2deg) !important; /* overrides nth-child transform */
        z-index: 5;
        border-color: #ff0044;
        box-shadow: 15px 15px 0px #00e5ff;
    }

    .gallery-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s;
        filter: grayscale(40%) contrast(1.2);
    }

    .gallery-item:hover img {
        transform: scale(1.1);
        filter: grayscale(0%) contrast(1.3);
    }

    @@keyframes glitch-anim {
        0% { transform: skew(0deg); }
        20% { transform: skew(-5deg); text-shadow: 10px 0px 0px rgba(255,0,68,1), -10px 0px 0px rgba(0,240,255,1); }
        21% { transform: skew(5deg); }
        22% { transform: skew(0deg); text-shadow: 6px 0px 0px rgba(255,0,68,1), -6px 0px 0px rgba(0,240,255,1); }
        60% { transform: skew(0deg); }
        61% { transform: skew(3deg); }
        62% { transform: skew(0deg); }
    }
</style>

<div class="hero-container">
    <div class="hero-bg"></div>
    <div class="hero-content">
        <h1 class="hero-glitch">EARTH-1610</h1>
        <div class="hero-subtitle">SPIDERMAN ACROSS THE SPIDER VERSE</div>
        <a asp-controller="Color" asp-action="Index" class="enter-btn">ENTER ARCHIVE ></a>
    </div>
</div>

<div class="comic-panel-container">
    <div class="comic-panel panel-1">
        <div class="panel-title">SCANNING...</div>
        <p class="panel-text">Monitoring dimensional breaches. Multiple unauthorized color hex signatures (Anomalies) detected drifting into the network.</p>
    </div>
    <div class="comic-panel panel-2">
        <div class="panel-title">VIBRANT</div>
        <p class="panel-text">Multi-layered architecture inspired by street graffiti. A vibrant fusion of electrifying Neon Pink and hyper-speed Cyan.</p>
    </div>
    <div class="comic-panel panel-3">
        <div class="panel-title">SECURE</div>
        <p class="panel-text">All localized color data is held in static chambers, awaiting safe return to their native dimensions.</p>
    </div>
</div>

<h2 class="gallery-title">SPIDER-SOCIETY ROSTER</h2>
<div class="spider-gallery">
    <div class="gallery-item">
        <img src="https://i.pinimg.com/1200x/03/0d/3c/030d3cd9c5b5b92a7fbe6e98a3203804.jpg" alt="Across The Spider-Verse" loading="lazy" />
    </div>
    <div class="gallery-item">
        <img src="https://i.pinimg.com/736x/69/2e/66/692e667eb776bd09542987ecfcaa4bac.jpg" alt="Into The Spider-Verse" loading="lazy" />
    </div>
    <div class="gallery-item">
        <img src="https://i.pinimg.com/736x/71/ac/34/71ac34982238cf1731516b287b0d271e.jpg" alt="Spider-Man PS4" loading="lazy" />
    </div>
    <div class="gallery-item">
        <img src="https://i.pinimg.com/1200x/f0/97/76/f09776a1ef7f3ede968bb0a42035d2b8.jpg" alt="Miles Morales Game" loading="lazy" />
    </div>
</div>
