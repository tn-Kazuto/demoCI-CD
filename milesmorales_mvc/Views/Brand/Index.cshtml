@model IEnumerable<milesmorales_mvc.Models.Brand>

@{
    ViewData["Title"] = "Brand Index";
}

<style>
    .spiderverse-container {
        margin-top: 3rem;
        margin-bottom: 3rem;
        padding: 3rem;
        background-color: rgba(15, 15, 20, 0.95);
        border: 5px solid #fff;
        box-shadow: 15px 15px 0px #ff0044, -15px -15px 0px #00e5ff;
        border-radius: 2px;
        position: relative;
        overflow: hidden;
        z-index: 1;
    }

    .spiderverse-watermark {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 80%;
        max-width: 600px;
        opacity: 0.08;
        pointer-events: none;
        z-index: 0;
        filter: drop-shadow(0 0 15px #00e5ff); /* Swap color for brand */
    }

    .spiderverse-title {
        font-family: 'Bangers', cursive;
        font-size: 6rem;
        color: white;
        text-align: center;
        margin-bottom: 30px;
        letter-spacing: 6px;
        text-shadow: 5px 0px 0px rgba(0, 240, 255, 0.9), -5px 0px 0px rgba(255, 0, 68, 0.9);
        transform: rotate(-2deg);
        position: relative;
        z-index: 2;
    }

    .btn-create {
        display: inline-block;
        font-family: 'Bangers', cursive;
        font-size: 2rem;
        background-color: #00e5ff; /* Primary color swapped */
        color: #111 !important;
        padding: 12px 30px;
        text-transform: uppercase;
        border: 4px solid #fff;
        box-shadow: 6px 6px 0px #ff0044;
        text-decoration: none;
        transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        transform: rotate(2deg);
        margin-bottom: 40px;
        position: relative;
        z-index: 2;
        letter-spacing: 2px;
    }

    .btn-create:hover {
        transform: scale(1.1) rotate(-1deg);
        box-shadow: 10px 10px 0px #ff0044, -5px -5px 0px #00e5ff;
        background-color: #000;
        color: #ff0044 !important;
        border-color: #ff0044;
    }

    .spiderverse-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 15px;
        font-family: 'Teko', sans-serif;
        font-size: 1.6rem;
        position: relative;
        z-index: 2;
    }

    .spiderverse-table th {
        font-family: 'Bangers', cursive;
        font-size: 2.2rem;
        color: #fff;
        text-shadow: 3px 3px 0px #ff0044;
        letter-spacing: 3px;
        border-bottom: 4px solid #00e5ff;
        padding-bottom: 15px;
        text-align: left;
    }

    .spiderverse-table td {
        background: rgba(26, 26, 36, 0.9);
        border-top: 2px solid #444;
        border-bottom: 2px solid #444;
        padding: 15px 20px;
        vertical-align: middle;
    }

    .spiderverse-table td:first-child {
        border-left: 6px solid #00e5ff;
        font-weight: 700;
        letter-spacing: 2px;
        font-size: 1.8rem;
    }
    
    .spiderverse-table td:last-child {
        border-right: 6px solid #ff0044;
    }

    .spiderverse-table tr {
        transition: all 0.2s;
    }

    .spiderverse-table tr:hover {
        transform: scale(1.03) translateX(10px);
        box-shadow: -15px 0px 0px rgba(255, 0, 68, 0.8), 15px 0px 0px rgba(0, 229, 255, 0.8);
    }
    
    .spiderverse-table tr:hover td {
        background: #000;
        color: #00e5ff;
    }

    .action-links {
        display: flex;
        gap: 15px;
    }

    .action-links a {
        display: inline-block;
        font-family: 'Teko', sans-serif;
        font-weight: 700;
        font-size: 1.5rem;
        text-transform: uppercase;
        text-decoration: none;
        padding: 5px 20px;
        border: 3px solid #fff;
        color: #fff;
        background: #111;
        transition: all 0.2s;
        box-shadow: 3px 3px 0px rgba(255,255,255,0.3);
    }

    .link-edit {
        border-color: #00e5ff !important;
        color: #00e5ff !important;
        box-shadow: 4px 4px 0px #00e5ff !important;
    }
    .link-edit:hover {
        background: #00e5ff !important;
        color: #000 !important;
        transform: translate(-3px, -3px);
        box-shadow: 8px 8px 0px #00e5ff !important;
    }

    .link-details {
        border-color: #bf00ff !important;
        color: #bf00ff !important;
        box-shadow: 4px 4px 0px #bf00ff !important;
    }
    .link-details:hover {
        background: #bf00ff !important;
        color: #fff !important;
        transform: translate(-3px, -3px);
        box-shadow: 8px 8px 0px #bf00ff !important;
    }

    .link-delete {
        border-color: #ff0044 !important;
        color: #ff0044 !important;
        box-shadow: 4px 4px 0px #ff0044 !important;
    }
    .link-delete:hover {
        background: #ff0044 !important;
        color: #fff !important;
        transform: translate(-3px, -3px);
        box-shadow: 8px 8px 0px #ff0044 !important;
    }
</style>

<div class="spiderverse-container">
    <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/c/ca/Miles_Morales_spider_logo.svg/1024px-Miles_Morales_spider_logo.svg.png" class="spiderverse-watermark" alt="Spider Logo Background" />

    <h1 class="spiderverse-title">BRAND INDEX</h1>

    <div style="text-align: center;">
        <a asp-action="Create" class="btn-create">INITIALIZE NEW BRAND</a>
    </div>

    <table class="spiderverse-table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.BrandName)
                </th>
                <th style="padding-left: 15px; width: 350px;">
                    ACTIONS
                </th>
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.BrandName)
                </td>
                <td>
                    <div class="action-links">
                        <a asp-action="Edit" asp-route-id="@item.BrandId" class="link-edit">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.BrandId" class="link-details">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.BrandId" class="link-delete">Delete</a>
                    </div>
                </td>
            </tr>
    }
        </tbody>
    </table>
</div>
