@model milesmorales_mvc.Models.Color

@{
    ViewData["Title"] = "Anomaly Details";
}

<style>
    .spider-details-card {
        max-width: 500px;
        margin: 5rem auto;
        padding: 0;
        background-color: rgba(15, 15, 20, 0.95);
        border: 4px solid #fff;
        box-shadow: 15px 15px 0px #bf00ff, -15px -15px 0px #00e5ff;
        position: relative;
        overflow: hidden;
    }

    .spider-card-header {
        background: #bf00ff;
        padding: 20px;
        text-align: center;
        border-bottom: 4px solid #fff;
    }

    .spider-card-title {
        font-family: 'Bangers', cursive;
        font-size: 3.5rem;
        color: #fff;
        margin: 0;
        letter-spacing: 5px;
        text-shadow: 3px 3px 0 #000;
    }

    .spider-card-body {
        padding: 30px;
    }

    .detail-label {
        font-family: 'Teko', sans-serif;
        font-size: 1.8rem;
        color: #00e5ff;
        margin-bottom: 5px;
        letter-spacing: 1.5px;
        border-bottom: 1px dashed #444;
    }

    .detail-value {
        font-family: 'Courier New', Courier, monospace;
        font-size: 1.6rem;
        color: #fff;
        margin-bottom: 25px;
        font-weight: bold;
    }

    .color-swatch-large {
        width: 100%;
        height: 60px;
        border: 3px solid #fff;
        box-shadow: inset 0 0 10px rgba(0,0,0,0.5), 5px 5px 0 #000;
        margin-top: 10px;
        margin-bottom: 30px;
        transform: skew(-5deg);
    }

    .spider-action-row {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        margin-top: 10px;
    }

    .spider-btn {
        flex: 1;
        text-align: center;
        font-family: 'Teko', sans-serif;
        font-size: 1.8rem;
        color: #fff;
        text-decoration: none;
        padding: 8px 15px;
        border: 2px solid #fff;
        transition: all 0.2s;
        text-transform: uppercase;
        background: #111;
        box-shadow: 4px 4px 0px rgba(255,255,255,0.2);
    }

    .btn-edit {
        border-color: #00e5ff;
        color: #00e5ff;
    }
    .btn-edit:hover {
        background: #00e5ff;
        color: #000;
        box-shadow: 6px 6px 0px #00e5ff;
        transform: translate(-2px, -2px);
    }

    .btn-back {
        border-color: #ff0044;
        color: #ff0044;
    }
    .btn-back:hover {
        background: #ff0044;
        color: #fff;
        box-shadow: 6px 6px 0px #ff0044;
        transform: translate(-2px, -2px);
    }
</style>

<div class="spider-details-card">
    <div class="spider-card-header">
        <h1 class="spider-card-title">ANOMALY RECORD</h1>
    </div>
    
    <div class="spider-card-body">
        <div class="detail-label">DESIGNATION</div>
        <div class="detail-value">@Html.DisplayFor(model => model.ColorName)</div>

        <div class="detail-label">HEX SIGNATURE</div>
        <div class="detail-value">@Html.DisplayFor(model => model.ColorHex)</div>

        <div class="detail-label">VISUAL SPECTRUM</div>
        <div class="color-swatch-large" style="background-color: @Model?.ColorHex;"></div>

        <div class="spider-action-row">
            <a asp-action="Edit" asp-route-id="@Model?.ColorId" class="spider-btn btn-edit">MODIFY</a>
            <a asp-action="Index" class="spider-btn btn-back">RETURN</a>
        </div>
    </div>
</div>
